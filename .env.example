# Claude API key (console.anthropic.com). Needed for ingest and the newsletter.
ANTHROPIC_API_KEY=

# Newsletter email via Resend (resend.com). Without these, issues are archived on the site only.
RESEND_API_KEY=
NEWSLETTER_TO=you@example.com
# Optional. The default test sender only delivers to your own Resend account email.
NEWSLETTER_FROM="AI Radar <onboarding@resend.dev>"

# Optional: public URL of the site, for the "Read on the web" link in emails.
SITE_URL=
