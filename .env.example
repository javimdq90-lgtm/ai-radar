# Claude API key (console.anthropic.com). Needed for ingest and the newsletter.
ANTHROPIC_API_KEY=

# Newsletter email via Resend (resend.com). Without these, issues are archived on the site only.
RESEND_API_KEY=
NEWSLETTER_TO=you@example.com
# Optional. The default test sender only delivers to your own Resend account email.
NEWSLETTER_FROM="Context Window <onboarding@resend.dev>"

# Optional: subscribers. On the site (e.g. Vercel) this opens the sign-up form: it emails a
# confirmation link and adds the address to this Resend segment once clicked (double opt-in; the
# API key needs full access). In the newsletter job it sends each issue to the whole segment as a
# broadcast instead of to NEWSLETTER_TO; that also needs NEWSLETTER_FROM on a verified domain and
# a postal address for the footer.
RESEND_SEGMENT_ID=
# Optional: signs confirmation links. Defaults to a key derived from RESEND_API_KEY.
SUBSCRIBE_SECRET=
NEWSLETTER_ADDRESS="Your name, street, city, country"

# Optional: public URL of the site, for the "Read on the web" link in emails.
SITE_URL=

# Membership (optional): no meter or paywall until both are set. See README, step 5.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# MEMBER_SECRET=
